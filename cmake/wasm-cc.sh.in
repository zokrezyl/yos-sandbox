#!/bin/bash
# Compile busybox for wasm32 WITHOUT wasi-libc
# Uses only our generated YOS stubs

ARGS=()
IS_COMPILE=0
IS_RELOCATABLE=0
for arg in "$@"; do
    case "$arg" in
        -c) IS_COMPILE=1; ARGS+=("$arg") ;;
        -r) IS_RELOCATABLE=1; ARGS+=("$arg") ;;
        -Wl,--start-group|-Wl,--end-group) ;;
        -Wl,--sort-common|-Wl,--sort-section*) ;;
        -Wl,--gc-sections|-Wl,--warn-common) ;;
        *) ARGS+=("$arg") ;;
    esac
done

# Add stubs only for final linking (not compile-only or relocatable)
LINK_OBJS=""
if [ "$IS_COMPILE" = "0" ] && [ "$IS_RELOCATABLE" = "0" ]; then
    LINK_OBJS="@BB_BUILD@/yos-stubs.o @BB_BUILD@/yos-generated.o"
fi

exec @WASI_CC_ABS@ --target=wasm32 \
    -nostdlib \
    -I@YOS_SRC_ABS@/wasm-stubs \
    -I@CODEGEN_DIR@/wasm-stubs \
    -L@BB_BUILD@/stub-libs \
    -include @YOS_SRC_ABS@/wasm-stubs/wasm-compat.h \
    -Wno-int-conversion \
    -Wno-incompatible-pointer-types \
    -Wno-implicit-function-declaration \
    -Wno-deprecated-non-prototype \
    -Wno-shift-op-parentheses \
    -Wno-string-plus-int \
    -Wno-gnu-designator \
    -Wno-bitwise-op-parentheses \
    -Wno-dangling-else \
    -Wno-unused-but-set-variable \
    -DOFF_T_MAX=9223372036854775807LL \
    -Wno-unknown-warning-option \
    -Wl,--no-entry \
    -Wl,--export=_start \
    -Wl,--export=main \
    -Wl,--export-all \
    -Wl,--whole-archive \
    -Wl,--allow-undefined \
    "${ARGS[@]}" \
    $LINK_OBJS
