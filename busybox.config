# Minimal busybox config for YOS/WASM
# Start from allnoconfig, enable what we need

# General
CONFIG_BUSYBOX=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_LONG_OPTS=y
CONFIG_LFS=y
CONFIG_PLATFORM_LINUX=y

# Build as single binary (applet mode)
CONFIG_FEATURE_INSTALLER=n
CONFIG_INSTALL_APPLET_SYMLINKS=n
CONFIG_FEATURE_SUID=n
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_BUSYBOX_EXEC_PATH="/proc/self/exe"

# Shell - ash
CONFIG_ASH=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_JOB_CONTROL=n
CONFIG_ASH_ALIAS=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
# Disable features that need signals/job control
CONFIG_ASH_SIGNALS=n

# Core utils
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_TEST=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_YES=y
CONFIG_PRINTF=y
CONFIG_LS=y
CONFIG_HEAD=y
CONFIG_TAIL=y
CONFIG_WC=y
CONFIG_SORT=y
CONFIG_UNIQ=y
CONFIG_TR=y
CONFIG_CUT=y
CONFIG_SEQ=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_SLEEP=y
CONFIG_DATE=y
CONFIG_ENV=y
CONFIG_ID=y
CONFIG_WHOAMI=y
CONFIG_UNAME=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_LN=y
CONFIG_PWD=y
CONFIG_READLINK=y
CONFIG_TOUCH=y
CONFIG_STAT=y
CONFIG_TEE=y
CONFIG_XARGS=y
CONFIG_FIND=y
CONFIG_GREP=y
CONFIG_SED=y
CONFIG_AWK=y
CONFIG_DIFF=y

# Process tools
CONFIG_PS=y
CONFIG_TOP=y
CONFIG_KILL=y
CONFIG_PGREP=y
CONFIG_PIDOF=y
CONFIG_PSTREE=y
CONFIG_FREE=y
CONFIG_UPTIME=y

# Misc
CONFIG_CLEAR=y
CONFIG_RESET=y
CONFIG_HEXDUMP=y
CONFIG_XXD=y
CONFIG_OD=y
CONFIG_MD5SUM=y
CONFIG_SHA1SUM=y
